# Copie para .env e ajuste os valores.

# Desenvolvimento local
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=troque-esta-chave

# Hosts permitidos (separados por vírgula)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=https://seu-app.vercel.app

# Banco de dados. Sem DATABASE_URL, usa SQLite (db.sqlite3).
# DATABASE_URL=postgres://usuario:senha@host:5432/banco?sslmode=require
# DB_CONN_MAX_AGE=0

# Mostra "demo / demo1234" na tela de login
SHOW_DEMO_CREDENTIALS=true
